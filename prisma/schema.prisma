// Prisma Schema for Sistema Autônomos (UFRJ Autônomos)
// Core ecosystem: Gestão + Ensino (ROS 2 Jazzy)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  TRAINEE
  MANAGEMENT
  COORDINATOR
  MEMBER
  ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  PROJECT
}

enum VideoStatus {
  AVAILABLE
  PENDING
  TEXT_ONLY
}

enum ExerciseType {
  CODE
  MULTIPLE_CHOICE
  TASK
}

enum AttendanceStatus {
  OPEN
  CLOSED
  REVIEW
  VOID
}

enum AttendancePunchType {
  IN
  OUT
}

enum MeetingAttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
  LATE
  NO_MEETING
  NOT_A_MEMBER
}

enum DisciplinaryWarningType {
  AVISO
  ADVERTENCIA_DIRETA
}

// ---------------------------------------------------------------------------
// 1. UNIFIED MEMBER & AUTHENTICATION (1 Member = 1 Platform User)
// ---------------------------------------------------------------------------

// Public site identities live in the institutional database (InstitutionalMember).
// Every platform user is a Member associated by email and linked via institutionalMemberId.
model Member {
  id                         String        @id @default(cuid())
  institutionalMemberId      Int?          @unique
  teamId                     Int?
  email                      String?       @unique
  name                       String
  role                       Role          @default(TRAINEE)
  status                     AccountStatus @default(PENDING)
  avatar                     String?
  area                       String        @default("Não informada")
  cpf                        String?       @unique
  phone                      String?
  dre                        String?       @unique
  birthDate                  DateTime?     @db.Date
  course                     String?
  academicPeriod             String?
  emergencyContactName       String?
  emergencyContactPhone      String?
  notes                      String?       @db.Text
  active                     Boolean       @default(true)
  inactivatedAt              DateTime?     @db.Date
  inactivationReason         String?
  pixKey                     String?
  pixKeyType                 String?
  profileCompletedAt         DateTime?     @db.Timestamptz(3)
  memberDirectoryPreferences Json?
  createdAt                  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime      @updatedAt @db.Timestamptz(3)

  // Credentials stored in a dedicated table linked by the member ID
  credential         MemberCredential?
  sessions           Session[]
  activityLogs       ActivityLog[]
  authChallenges     AuthChallenge[]
  profileChanges     MemberProfileChange[] @relation("MemberChanges")
  reviewedChanges    MemberProfileChange[] @relation("ReviewedChanges")

  // Attendance relations
  attendancePeriods  AttendancePeriod[]
  attendanceVisits   AttendanceVisit[]
  attendanceJustifications AttendanceJustification[] @relation("JustificationMember")
  reviewedAttendanceJustifications AttendanceJustification[] @relation("JustificationReviewer")
  attendancePunches  AttendancePunch[]
  attendanceAudits   AttendanceAudit[]     @relation("AuditedMember")
  performedAudits    AttendanceAudit[]     @relation("AuditActor")

  // Ensino relations
  courseProgress     CourseProgress[]
  lessonProgress     LessonProgress[]
  exerciseProgress   ExerciseProgress[]

  // Meeting relations
  meetingAttendances MeetingAttendance[]
  createdMeetings    Meeting[]             @relation("CreatedMeetings")

  // Disciplinary relations
  disciplinaryWarnings DisciplinaryWarning[] @relation("MemberWarnings")
  issuedWarnings       DisciplinaryWarning[] @relation("IssuedWarnings")

  // Financial relations
  financialEntriesRequested   FinancialEntry[]     @relation("FinancialRequester")
  financialEntriesReviewed    FinancialEntry[]     @relation("FinancialReviewer")
  financialStatementsUploaded FinancialStatement[] @relation("FinancialStatementUploader")

  // Inventory / Asset relations
  assetsInCustody   InventoryAsset[]      @relation("AssetCustodian")
  assetsCreated     InventoryAsset[]      @relation("AssetCreator")
  assetsUpdated     InventoryAsset[]      @relation("AssetUpdater")
  assetEvents       InventoryAssetEvent[] @relation("AssetEventActor")

  // Feedback / Bugs & Ideas relations
  feedbackSubmitted FeedbackItem[]        @relation("FeedbackAuthor")
  feedbackAssigned  FeedbackItem[]        @relation("FeedbackAssignee")
  feedbackReviewed  FeedbackItem[]        @relation("FeedbackReviewer")
  feedbackVotes     FeedbackVote[]

  @@index([email])
  @@index([institutionalMemberId])
}

model MemberCredential {
  memberId          String    @id
  member            Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  passwordHash      String
  passwordChangedAt DateTime  @default(now()) @db.Timestamptz(3)
  lastLoginAt       DateTime? @db.Timestamptz(3)
}

model AuthChallenge {
  id         String    @id @default(cuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  email      String
  purpose    String    @default("PASSWORD_RESET")
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, purpose])
  @@index([memberId])
}

model MemberProfileChange {
  id                    String              @id @default(cuid())
  memberId              String
  member                Member              @relation("MemberChanges", fields: [memberId], references: [id], onDelete: Cascade)
  institutionalMemberId Int
  changes               Json
  status                ChangeRequestStatus @default(PENDING)
  reviewedById          String?
  reviewedBy            Member?             @relation("ReviewedChanges", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt            DateTime?           @db.Timestamptz(3)
  reviewNote            String?             @db.Text
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)

  @@index([memberId, status])
  @@index([institutionalMemberId, status])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([memberId])
  @@index([sessionToken])
}

// Shared across serverless instances; identifiers are stored as keyed hashes.
model AuthRateLimit {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// 2. ENSINO SUBSYSTEM: COURSES, MODULES, LESSONS, EXERCISES
// ---------------------------------------------------------------------------

model Course {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  subtitle      String?
  description   String   @db.Text
  coverImage    String?
  badge         String?
  level         String   @default("Iniciante")
  durationHours Float    @default(15.0)
  published     Boolean  @default(true)
  orderIndex    Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  modules        Module[]
  courseProgress CourseProgress[]

  @@index([slug])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug        String?
  title       String
  description String?  @db.Text
  orderIndex  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]

  @@unique([courseId, orderIndex])
  @@index([courseId])
}

model Lesson {
  id                   String      @id @default(cuid())
  moduleId             String
  module               Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug                 String
  title                String
  orderIndex           Int
  lessonType           LessonType  @default(VIDEO)
  videoStatus          VideoStatus @default(PENDING)
  youtubeVideoId       String?
  videoDurationSeconds Int?
  summary              String?     @db.Text
  textContent          String      @db.Text
  rosDocsUrl           String?
  codeZipPath          String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  exercises      Exercise[]
  lessonProgress LessonProgress[]

  @@unique([moduleId, orderIndex])
  @@unique([moduleId, slug])
  @@index([moduleId])
}

model Exercise {
  id            String       @id @default(cuid())
  lessonId      String
  lesson        Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title         String
  type          ExerciseType @default(CODE)
  prompt        String       @db.Text
  instructions  String?      @db.Text
  starterCode   String?      @db.Text
  solutionCode  String?      @db.Text
  hints         String?      @db.Text
  options       String?      @db.Text
  correctOption Int?
  testCasesJson String?      @db.Text
  points        Int          @default(10)
  orderIndex    Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  submissions ExerciseProgress[]

  @@index([lessonId])
}

// ---------------------------------------------------------------------------
// 3. PROGRESS TRACKING & PERSISTENCE
// ---------------------------------------------------------------------------

model CourseProgress {
  id                    String    @id @default(cuid())
  memberId              String
  member                Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  courseId              String
  course                Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  percentage            Float     @default(0.0)
  completedLessonsCount Int       @default(0)
  totalLessonsCount     Int       @default(0)
  lastLessonId          String?
  isCompleted           Boolean   @default(false)
  completedAt           DateTime?
  enrolledAt            DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([memberId, courseId])
  @@index([memberId])
  @@index([courseId])
}

model LessonProgress {
  id              String    @id @default(cuid())
  memberId        String
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed       Boolean   @default(false)
  completedAt     DateTime?
  lastPositionSec Int       @default(0)
  updatedAt       DateTime  @updatedAt

  @@unique([memberId, lessonId])
  @@index([memberId])
  @@index([lessonId])
}

model ExerciseProgress {
  id              String   @id @default(cuid())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  completed       Boolean  @default(false)
  submittedAnswer String?  @db.Text
  passed          Boolean  @default(false)
  score           Int      @default(0)
  attempts        Int      @default(1)
  submittedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([memberId, exerciseId])
  @@index([memberId])
  @@index([exerciseId])
}

// ---------------------------------------------------------------------------
// 4. GESTÃO & PRESENÇA ECOSYSTEM
// ---------------------------------------------------------------------------

model ProjectDetails {
  id                     String   @id @default(cuid())
  institutionalProjectId Int      @unique
  notes                  String?  @db.Text
  updatedAt              DateTime @updatedAt
}

model AttendanceSettings {
  id                  String   @id @default("lab")
  qrCode              String   @unique
  weeklyTargetSeconds Int      @default(7200)
  maxSessionSeconds   Int      @default(43200)
  startedAt           DateTime @default(now()) @db.Timestamptz(3)
}

model AttendancePeriod {
  id            String    @id @default(cuid())
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  startsOn      DateTime  @db.Date
  endsOn        DateTime? @db.Date
  targetSeconds Int       @default(7200)

  @@unique([memberId, startsOn])
  @@index([memberId, endsOn])
}

model AttendanceVisit {
  id           String           @id @default(cuid())
  memberId     String
  member       Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkedInAt  DateTime         @db.Timestamptz(3)
  checkedOutAt DateTime?        @db.Timestamptz(3)
  status       AttendanceStatus @default(OPEN)
  source       String           @default("QR")
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  punches      AttendancePunch[]
  audits       AttendanceAudit[]

  @@index([memberId, checkedInAt])
  @@index([status, checkedInAt])
}

model AttendancePunch {
  id           String              @id @default(cuid())
  requestId    String              @unique
  memberId     String
  member       Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  visitId      String
  visit        AttendanceVisit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  type         AttendancePunchType
  registeredAt DateTime            @default(now()) @db.Timestamptz(3)

  @@index([memberId, registeredAt])
}

model AttendanceAudit {
  id        String           @id @default(cuid())
  memberId  String
  member    Member           @relation("AuditedMember", fields: [memberId], references: [id], onDelete: Cascade)
  visitId   String?
  visit     AttendanceVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     Member?          @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  reason    String
  before    Json?
  after     Json?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  @@index([memberId, createdAt])
}

// Immutable through the application: no update/delete endpoints. Account removal
// detaches the FK but keeps the actor snapshot and the event history.
model ActivityLog {
  id            String   @id @default(cuid())
  clientEventId String?  @unique @db.VarChar(64)
  summaryKey    String?  @unique @db.VarChar(64)
  occurrences   Int      @default(1)
  lastOccurredAt DateTime @default(now()) @db.Timestamptz(3)
  actorId       String?
  actor         Member?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName     String?  @db.VarChar(200)
  actorRole     String?  @db.VarChar(24)
  kind          String   @db.VarChar(24)
  action        String   @db.VarChar(100)
  path          String   @db.VarChar(300)
  targetPath    String?  @db.VarChar(300)
  control       String?  @db.VarChar(60)
  outcome       String   @db.VarChar(16)
  method        String?  @db.VarChar(8)
  statusCode    Int?
  durationMs    Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt, id])
  @@index([lastOccurredAt, id])
  @@index([actorId, createdAt])
  @@index([kind, createdAt])
  @@index([outcome, createdAt])
}


model AttendanceJustification {
  id             String   @id @default(cuid())
  memberId       String
  member         Member   @relation("JustificationMember", fields: [memberId], references: [id], onDelete: Cascade)
  weekStartsOn   DateTime @db.Date
  reason         String   @db.VarChar(40)
  details        String   @db.Text
  status         String   @default("PENDING") @db.VarChar(16)
  reviewedById   String?
  reviewedBy     Member?  @relation("JustificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewerName   String?  @db.VarChar(200)
  reviewNote     String?  @db.Text
  reviewedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([memberId, weekStartsOn])
  @@index([status, createdAt, id])
}

// ---------------------------------------------------------------------------
// 7. MEETING ATTENDANCE & ACCOUNTING (Reuniões de Área e Gerais)
// ---------------------------------------------------------------------------

model MeetingPeriod {
  id          String    @id @default(cuid())
  code        String    @unique // ex: "26.2", "27.1"
  name        String    // ex: "Semestre 26.2", "Ciclo 27.1"
  description String?   @db.Text
  startsAt    DateTime? @db.Date
  endsAt      DateTime? @db.Date
  isCurrent   Boolean   @default(false)
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([code])
  @@index([isCurrent])
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  date        DateTime @db.Date
  area        String   // "Software" | "Mecânica" | "Eletrônica" | "Gestão" | "Marketing"
  teamId      Int?     // 1 = Nautilus, 2 = Harpia, null = Autônomos (Geral)
  period      String   @default("26.2")
  description String?  @db.Text
  minutes String? @db.Text
  minutesSummary String? @db.Text
  minutesSummarySource String? @db.VarChar(16)
  minutesUpdatedAt DateTime? @db.Timestamptz(3)
  createdById String?
  createdBy   Member?  @relation("CreatedMeetings", fields: [createdById], references: [id], onDelete: SetNull)

  attendances MeetingAttendance[]

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([area, teamId])
  @@index([period])
  @@index([date])
}

model MeetingAttendance {
  id        String                  @id @default(cuid())
  meetingId String
  meeting   Meeting                 @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    MeetingAttendanceStatus @default(NOT_A_MEMBER)
  notes     String?                 @db.Text

  createdAt DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt DateTime                @updatedAt @db.Timestamptz(3)

  @@unique([meetingId, memberId])
  @@index([memberId])
  @@index([meetingId])
}

// ---------------------------------------------------------------------------
// 7. GESTÃO DISCIPLINAR (Avisos e Advertências)
// ---------------------------------------------------------------------------

model DisciplinaryWarning {
  id         String                  @id @default(cuid())
  memberId   String
  member     Member                  @relation("MemberWarnings", fields: [memberId], references: [id], onDelete: Cascade)
  type       DisciplinaryWarningType @default(AVISO)
  reason     String                  @db.Text
  notes      String?                 @db.Text
  issuedById String?
  issuedBy   Member?                 @relation("IssuedWarnings", fields: [issuedById], references: [id], onDelete: SetNull)
  createdAt  DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @db.Timestamptz(3)

  @@index([memberId])
  @@index([issuedById])
  @@index([type])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// 8. SISTEMA FINANCEIRO (Livro Caixa, Entradas, Saídas e Reembolsos)
// ---------------------------------------------------------------------------

enum FinancialEntryType {
  ENTRADA
  SAIDA
}

enum FinancialEntryStatus {
  PENDENTE
  APROVADO
  AGUARDANDO_REEMBOLSO
  AGUARDANDO_NF
  PAGO
  RECUSADO
}

model FinancialEntry {
  id              String                @id @default(cuid())
  code            String                @unique
  type            FinancialEntryType
  isReimbursement Boolean               @default(false)
  title           String
  description     String?               @db.Text
  category        String                @default("Administrativo")
  fundSource      String                @default("Dinheiro Livre")
  team            String                @default("Geral")
  amountCents     Int
  occurredAt      DateTime?             @db.Date
  status          FinancialEntryStatus  @default(PENDENTE)
  requesterId     String?
  requester       Member?               @relation("FinancialRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  requesterName   String
  pixKey          String?
  pixKeyType      String?
  driveFolderId   String?
  driveFolderUrl  String?
  reviewNotes     String?               @db.Text
  reviewedById    String?
  reviewedBy      Member?               @relation("FinancialReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?             @db.Timestamptz(3)
  paidAt          DateTime?             @db.Timestamptz(3)
  attachments     FinancialAttachment[]
  assets          InventoryAsset[]
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)

  @@index([type, status])
  @@index([isReimbursement, status])
  @@index([requesterId])
  @@index([occurredAt])
  @@index([category])
}

model FinancialAttachment {
  id          String         @id @default(cuid())
  entryId     String
  entry       FinancialEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  name        String
  url         String
  driveFileId String?
  mimeType    String?
  kind        String         @default("RECEIPT") // RECEIPT | PAYMENT_PROOF | STATEMENT
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  @@index([entryId])
}

model FinancialStatement {
  id            String   @id @default(cuid())
  title         String
  fundSource    String   @default("Dinheiro Livre") // "Dinheiro Livre" | "Conta Coppetec"
  referenceDate DateTime @db.Date
  fileName      String
  fileUrl       String
  mimeType      String?
  notes         String?  @db.Text
  uploadedById  String?
  uploadedBy    Member?  @relation("FinancialStatementUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([fundSource, referenceDate])
  @@index([referenceDate])
}

// ---------------------------------------------------------------------------
// 9. GESTÃO DE PATRIMÔNIO & MATERIAIS DA EQUIPE
// ---------------------------------------------------------------------------

enum AssetAcquisitionStatus {
  PLANEJADO
  EM_COTACAO
  COMPRADO_AGUARDANDO
  ADQUIRIDO
  EMPRESTADO
  MANUTENCAO
  BAIXADO
}

enum AssetCondition {
  NOVO
  BOM
  DESGASTADO
  DEFEITO_PARCIAL
  ESTRAGADO
}

model InventoryAsset {
  id                      String                 @id @default(cuid())
  assetTag                String                 @unique // ex: PAT-001
  name                    String
  description             String?                @db.Text
  category                String                 @default("Eletrônica & Embarcados")
  team                    String                 @default("Geral")
  area                    String                 @default("Geral")
  quantity                Int                    @default(1)
  unit                    String                 @default("un")
  unitPriceCents          Int                    @default(0)
  totalPriceCents         Int                    @default(0)
  acquisitionStatus       AssetAcquisitionStatus @default(ADQUIRIDO)
  condition               AssetCondition         @default(BOM)
  damageNotes             String?                @db.Text
  acquiredAt              DateTime?              @db.Date
  expectedAcquisitionDate DateTime?              @db.Date
  warrantyUntil           DateTime?              @db.Date
  acquisitionSource       String?                @default("Dinheiro Livre")
  supplier                String?
  purchaseUrl             String?
  serialNumber            String?
  location                String?
  custodianId             String?
  custodian               Member?                @relation("AssetCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  custodianName           String?
  financialEntryId        String?
  financialEntry          FinancialEntry?        @relation(fields: [financialEntryId], references: [id], onDelete: SetNull)
  photoUrl                String?
  invoiceUrl              String?
  invoiceName             String?
  createdById             String?
  createdBy               Member?                @relation("AssetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById             String?
  updatedBy               Member?                @relation("AssetUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  events                  InventoryAssetEvent[]
  createdAt               DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @db.Timestamptz(3)

  @@index([acquisitionStatus, condition])
  @@index([category])
  @@index([team])
  @@index([custodianId])
  @@index([acquiredAt])
}

model InventoryAssetEvent {
  id        String         @id @default(cuid())
  assetId   String
  asset     InventoryAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  eventType String
  title     String
  notes     String?        @db.Text
  actorId   String?
  actor     Member?        @relation("AssetEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String?
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  @@index([assetId, createdAt])
}

// ---------------------------------------------------------------------------
// 10. REPORTES DE BUGS, MELHORIAS, IDEIAS & OUVIDORIA (Equipe, Lab, Sistema, Site)
// ---------------------------------------------------------------------------

enum FeedbackScope {
  SISTEMA
  SITE
  LABORATORIO
  EQUIPE
}

enum FeedbackCategory {
  BUG
  MELHORIA
  IDEIA
  PROBLEMA_LAB
  PROCESSO
}

enum FeedbackStatus {
  RECEBIDA
  EM_ANALISE
  APROVADA
  EM_ANDAMENTO
  APLICADA
  ARQUIVADA
}

enum FeedbackValidity {
  PENDENTE
  VALIDA
  PARCIALMENTE_VALIDA
  INVALIDA_OU_DUPLICADA
}

enum FeedbackPriority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

model FeedbackItem {
  id               String           @id @default(cuid())
  code             String           @unique // ex: FB-001
  scope            FeedbackScope    @default(SISTEMA)
  category         FeedbackCategory @default(IDEIA)
  title            String
  description      String           @db.Text
  pageOrLocation   String?
  stepsToReproduce String?          @db.Text
  expectedOutcome  String?          @db.Text
  attachmentUrl    String?
  attachmentName   String?
  isAnonymous      Boolean          @default(false)
  authorId         String?
  author           Member?          @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName       String
  status           FeedbackStatus   @default(RECEBIDA)
  validity         FeedbackValidity @default(PENDENTE)
  priority         FeedbackPriority @default(MEDIA)
  assignedArea     String?
  assignedToId     String?
  assignedTo       Member?          @relation("FeedbackAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  responseNotes    String?          @db.Text
  appliedAt        DateTime?        @db.Timestamptz(3)
  reviewedById     String?
  reviewedBy       Member?          @relation("FeedbackReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?        @db.Timestamptz(3)
  votes            FeedbackVote[]
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  @@index([scope, status])
  @@index([category, status])
  @@index([validity])
  @@index([authorId])
  @@index([createdAt])
}

model FeedbackVote {
  id         String       @id @default(cuid())
  feedbackId String
  feedback   FeedbackItem @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([feedbackId, memberId])
  @@index([memberId])
}
