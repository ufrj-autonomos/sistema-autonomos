# PostgreSQL: connection used by the application and direct connection for schema changes.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Generate a random signing key of at least 32 characters. Do not use this placeholder.
JWT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Supabase configuration. Keep service credentials on the server.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""
