# Configure these values on Vercel too; this file does not contain real credentials.
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://sistema-autonomos-gamma.vercel.app"

# Runtime PostgreSQL connection and direct connection used by Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require&connection_limit=1&pool_timeout=10&connect_timeout=10"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require&connect_timeout=10"

# Generate each secret independently with at least 32 random characters.
JWT_SECRET=""
CRON_SECRET=""

# Vercel automatically supplies trusted forwarding headers. Keep this false
# outside Vercel unless your own reverse proxy overwrites forwarding headers.
TRUST_PROXY_HEADERS="false"
SEED_DEMO_USERS="false"
