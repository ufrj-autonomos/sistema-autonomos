      "name": "Ação primary",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ação com variáveis vivas de ambos os temas.",
      "html": "<button class=\"ds-primary\" type=\"button\">Abrir integrantes</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;gap:10px;min-height:44px;border-radius:7px;padding:10px 16px;font-size:14px;font-weight:500;cursor:pointer;background:var(--primary);color:var(--primary-foreground);border:1px solid transparent;font-family:var(--font-sans,Inter,system-ui,sans-serif);}.ds-primary:hover{opacity:.88;}.ds-primary:focus-visible{outline:2px solid var(--ring);outline-offset:3px;}.ds-primary:disabled{opacity:.5;cursor:wait}"
    },
    {
      "name": "Ação secondary",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Ação com variáveis vivas de ambos os temas.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Acompanhar presença</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;gap:10px;min-height:44px;border-radius:7px;padding:10px 16px;font-size:14px;font-weight:500;cursor:pointer;background:var(--card);color:var(--foreground);border:1px solid var(--border);font-family:var(--font-sans,Inter,system-ui,sans-serif);}.ds-secondary:hover{background:var(--accent);border-color:var(--input);}.ds-secondary:focus-visible{outline:2px solid var(--ring);outline-offset:3px;}"
    },
    {
      "name": "Campo de trabalho",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Campo com contorno e nome acessível.",
      "html": "<label class=\"ds-label\" for=\"ds-member\">Integrante</label><input class=\"ds-input\" id=\"ds-member\" placeholder=\"Buscar por nome\">",
      "css": ".ds-label{display:block;margin-bottom:8px;color:var(--foreground);font-size:14px;font-family:var(--font-sans,Inter,system-ui,sans-serif);}.ds-input{min-height:48px;border:1px solid var(--input);border-radius:7px;background:var(--background);color:var(--foreground);padding:10px 12px;font-size:16px;font-family:var(--font-sans,Inter,system-ui,sans-serif);}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:focus-visible{outline:2px solid var(--ring);outline-offset:3px;}"
    },
    {
      "name": "Navegação rotulada",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Seleção neutra com estado de página atual.",
      "html": "<nav aria-label=\"Ferramentas da gestão\"><a class=\"ds-nav\" href=\"#integrantes\" aria-current=\"page\">Integrantes</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:12px;min-height:44px;padding:10px 12px;border-radius:7px;color:var(--muted-foreground);text-decoration:none;font-size:14px;font-family:var(--font-sans,Inter,system-ui,sans-serif);}.ds-nav:hover,.ds-nav[aria-current=\"page\"]{background:var(--accent);color:var(--foreground)}.ds-nav[aria-current=\"page\"]{font-weight:600}.ds-nav:focus-visible{outline:2px solid var(--ring);outline-offset:3px;}"
    },
