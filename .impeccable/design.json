  "narrative": {
    "northStar": "Achromatic ledger",
    "overview": "O Achromatic ledger organiza o trabalho diário com superfícies neutras, hierarquia tipográfica clara e separadores discretos. A marca oficial da UFRJ Autônomos identifica o sistema; pessoas, solicitações e horas de laboratório ocupam a atenção.\n\nA interface usa Inter, painéis contidos e ações principais em tinta. Azul acompanha progresso e foco. Os temas claro e escuro compartilham papéis semânticos; o ensino preserva sua composição e suas famílias tipográficas existentes dentro de uma moldura que acompanha o tema.",
    "keyCharacteristics": [
      "Superfícies neutras e ações em tinta.",
      "Hierarquia compacta e dados com algarismos tabulares.",
      "Progresso azul e estados explicados por texto.",
      "Navegação rotulada, com adaptação ao celular."
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "Use os papéis semânticos do tema para superfícies, texto, bordas e interação. O cartaz QR é a exceção de impressão com branco e texto escuro fixos.",
        "section": "colors"
      },
      {
        "name": "The Data Accent Rule",
        "body": "Reserve o azul de dados para progresso e foco. Ações e navegação usam neutros; cores de estado acompanham texto explicativo.",
        "section": "colors"
      },
      {
        "name": "The Course Continuity Rule",
        "body": "Preserve a estrutura do ensino e suas famílias display e mono existentes. Essa continuidade não define a tipografia de novas superfícies de trabalho.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do usar variáveis semânticas em ambos os temas.",
      "Do manter rótulos na navegação e nomes acessíveis nos botões de ícone.",
      "Do manter foco visível e retorno de foco nos diálogos.",
      "Do distinguir fila vazia de dado indisponível.",
      "Do preservar módulos, aulas, exercícios e progresso do curso ao adaptar cores.",
      "Do manter o cartaz QR branco e com texto escuro."
    ],
    "donts": [
      "Don't usar azul como decoração do chrome ou em todas as ações principais.",
      "Don't aplicar temas de divisão como aparência padrão do workspace.",
      "Don't cobrir a última ação com a barra inferior móvel.",
      "Don't promover ornamentos e rótulos técnicos legados do ensino a regras globais.",
      "Don't declarar validação visual por screenshot sem essa evidência."
    ]
  }
