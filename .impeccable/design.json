      "name": "Painel de trabalho",
      "kind": "card",
      "refersTo": "panel",
      "description": "Painel plano com borda e título.",
      "html": "<section class=\"ds-panel\" aria-labelledby=\"ds-panel-title\"><h2 id=\"ds-panel-title\">Pendências da equipe</h2><p>O que precisa da sua revisão.</p><a href=\"#fila\">Abrir lista</a></section>",
      "css": ".ds-panel{border:1px solid var(--border);border-radius:12px;background:var(--card);color:var(--card-foreground);padding:20px;font-family:var(--font-sans,Inter,system-ui,sans-serif);}.ds-panel h2{margin:0;font-size:16px;line-height:24px;font-weight:600}.ds-panel p{margin:4px 0 16px;font-size:14px;line-height:20px;color:var(--muted-foreground)}.ds-panel a{display:inline-flex;align-items:center;min-height:44px;color:var(--foreground);font-size:14px;text-underline-offset:4px}.ds-panel a:hover{text-decoration:underline}.ds-panel a:focus-visible{outline:2px solid var(--ring);outline-offset:3px;}@media(min-width:640px){.ds-panel{padding:24px}}"
    },
    {
      "name": "Meta de presença",
      "kind": "custom",
      "refersTo": "progress",
      "description": "Progresso nativo com valor acessível.",
      "html": "<label class=\"ds-progress-label\" for=\"ds-goal\">Meta semanal de presença</label><progress id=\"ds-goal\" class=\"ds-progress\" value=\"0\" max=\"2\">0 de 2 horas</progress>",
      "css": ".ds-progress-label{display:block;margin-bottom:12px;color:var(--foreground);font-size:14px;font-family:var(--font-sans,Inter,system-ui,sans-serif);}.ds-progress{appearance:none;width:100%;height:8px;overflow:hidden;border:0;border-radius:999px;background:var(--muted);color:var(--data-accent);accent-color:var(--data-accent)}.ds-progress::-webkit-progress-bar{background:var(--muted);border-radius:999px}.ds-progress::-webkit-progress-value{background:var(--data-accent);border-radius:999px}.ds-progress::-moz-progress-bar{background:var(--data-accent);border-radius:999px}"
    },
