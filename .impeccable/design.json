      "css": ".ds-count{display:inline-flex;align-items:center;justify-content:center;min-height:32px;min-width:32px;padding:0 8px;border-radius:8px;background:var(--muted);color:var(--muted-foreground);font-size:14px;font-weight:600;font-variant-numeric:tabular-nums;font-family:var(--font-sans,Inter,system-ui,sans-serif);}"
