      "css": ".ds-icon{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;border:0;border-radius:8px;background:transparent;color:var(--muted-foreground);cursor:pointer}.ds-icon:hover{background:var(--accent);color:var(--foreground)}.ds-icon:focus-visible{outline:2px solid var(--ring);outline-offset:3px;}"
    }
