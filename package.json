{
  "name": "sistema-autonomos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build --webpack",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:access-control": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20261101000000_access_control/migration.sql",
    "db:bootstrap-admin": "node --import tsx scripts/bootstrap-admin.ts",
    "test:access": "node --import tsx tests/access-control.test.ts",
    "typecheck": "tsc --noEmit",
    "db:deploy": "prisma migrate deploy",
    "build:vercel": "node scripts/vercel-build.mjs",
    "check:production": "node scripts/check-production-env.mjs",
    "test:production": "node --import tsx tests/production-security.test.ts",
    "test:gestao": "node --import tsx tests/gestao-production.test.ts",
    "test": "npm run test:access && npm run test:production && npm run test:gestao && npm run test:attendance",
    "test:database": "node --import tsx tests/database-production.test.ts && node --import tsx tests/attendance-database.test.ts",
    "test:attendance": "node --import tsx tests/attendance.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "jose": "^6.0.8",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "engines": {
    "node": ">=22 <25"
  }
}
